<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_hero">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/maguey" />

    <View
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@color/login_overlay" />

    <!-- LOGO Y NOMBRE -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metl"
                android:textColor="@color/login_brand"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maguey inteligente"
                android:textColor="@color/login_brand"
                android:textSize="15sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- CONTENIDO DEL LOGIN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="230dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sheet_bg"
                android:minHeight="540dp"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="140dp"
                android:paddingEnd="32dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Iniciar sesión"
                    android:textColor="@color/login_ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- CORREO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Correo"
                    android:textColor="@color/login_ink"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bg_underline"
                    android:hint="tucorreo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:paddingTop="6dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:textColor="@color/login_ink"
                    android:textColorHint="@color/login_muted"
                    android:textSize="16sp" />

                <!-- CONTRASEÑA -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etPass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:background="@drawable/bg_underline"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:paddingTop="6dp"
                        android:paddingEnd="100dp"
                        android:paddingBottom="10dp"
                        android:singleLine="true"
                        android:textColor="@color/login_ink"
                        android:textColorHint="@color/login_muted"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:padding="6dp"
                        android:text="¿Olvidaste?"
                        android:textColor="@color/login_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- MENSAJE DE ERROR -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="#D64545"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- BOTÓN ENTRAR -->
                <TextView
                    android:id="@+id/btnEntrar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_login"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Entrar"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- REDES SOCIALES -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center"
                    android:text="O continúa con"
                    android:textColor="@color/login_muted"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_social"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="G"
                            android:textColor="#4285F4"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Google"
                            android:textColor="@color/login_muted"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_social"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="f"
                            android:textColor="#1877F2"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Facebook"
                            android:textColor="@color/login_muted"
                            android:textSize="15sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- CREAR CUENTA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿No tienes cuenta? "
                        android:textColor="@color/login_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvCrear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crear ahora"
                        android:textColor="@color/login_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- CAMBIAR TEMA -->
    <TextView
        android:id="@+id/btnTema"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="☾"
        android:textColor="@color/login_ink"
        android:textSize="18sp" />

</FrameLayout>
