<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_sheet"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Crear cuenta"
            android:textColor="@color/login_ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Únete a Metl"
            android:textColor="@color/login_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Nombre"
            android:textColor="@color/login_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:autofillHints="name"
            android:background="@drawable/bg_underline"
            android:hint="Tu nombre"
            android:inputType="textPersonName|textCapWords"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/login_ink"
            android:textColorHint="@color/login_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correo"
            android:textColor="@color/login_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCorreoR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_underline"
            android:hint="tucorreo@ejemplo.com"
            android:inputType="textEmailAddress"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/login_ink"
            android:textColorHint="@color/login_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textColor="@color/login_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_underline"
            android:hint="Mínimo 4 caracteres"
            android:inputType="textPassword"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/login_ink"
            android:textColorHint="@color/login_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar contraseña"
            android:textColor="@color/login_ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPass2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_underline"
            android:hint="Repite tu contraseña"
            android:inputType="textPassword"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/login_ink"
            android:textColorHint="@color/login_muted"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soy"
            android:textColor="@color/login_ink"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Cliente"
                android:textColor="@color/login_ink" />

            <RadioButton
                android:id="@+id/rbProductor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Productor"
                android:textColor="@color/login_ink" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvErrorR"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#D64545"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_login"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Crear cuenta"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Ya tienes cuenta? "
                android:textColor="@color/login_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvYaTengo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Inicia sesión"
                android:textColor="@color/login_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>